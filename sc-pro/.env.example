# Copy to .env.local (same values as ais/.env.local — shared Supabase project)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# S&C Assistant — dev proxy reads this in vite.config (same VITE_ pattern as Supabase above).
# Do not use import.meta.env.VITE_ANTHROPIC_API_KEY in React code, or the key can ship in the browser bundle.
VITE_ANTHROPIC_API_KEY=sk-ant-api03-your-key-here
